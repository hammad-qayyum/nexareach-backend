# Development settings for your laptop. Copy to .env and fill in ENCRYPTION_KEY (never commit .env):
#   cp .env.example .env
# The production server uses deploy/production.env instead (see deploy/README.md).

# Which copy this is. "development" only sends email through Mailpit, never to real people.
APP_ENV=development

# The development database from deploy/docker-compose.dev.yml (port 5433)
DATABASE_URL=postgresql+psycopg://fastnexa:fastnexa@localhost:5433/fastnexa_outreach

# Encrypts mailbox passwords and 2-step keys. Make a NEW one for development; never reuse production's:
#   .venv/bin/python -m app.cli generate-key
ENCRYPTION_KEY=

APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
# Interactive API docs at http://localhost:8000/api/docs
API_DOCS=true

# Lets the development mailboxes send to Mailpit (localhost:1025) without encryption
SMTP_ALLOW_PLAIN=true

# Error tracking: leave empty in development
SENTRY_DSN=
