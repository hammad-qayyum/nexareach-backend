# Database
POSTGRES_USER=fastnexa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fastnexa_outreach
DATABASE_URL=postgresql+psycopg://fastnexa:change-me@db:5432/fastnexa_outreach

# AES-GCM key for encrypting mailbox passwords, tokens and API keys (32 random bytes, base64)
ENCRYPTION_KEY=

# Session cookie signing
SESSION_SECRET=

# Public URL of the app
APP_BASE_URL=https://outreach.fastnexa.com

# Local testing only: allow unencrypted SMTP so a mailbox can send to Mailpit (localhost:1025)
SMTP_ALLOW_PLAIN=false

# Error tracking (GlitchTip or Sentry)
SENTRY_DSN=

# Microsoft app registration (Outlook helper accounts)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
