# Production settings. Copy to production.env (never commit it) and fill in every value.

# --- The site
APP_DOMAIN=outreach.fastnexa.com
APP_BASE_URL=https://outreach.fastnexa.com
COOKIE_SECURE=true
API_DOCS=false

# --- Database (used by the db container and the app)
POSTGRES_USER=fastnexa
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=fastnexa_outreach
DATABASE_URL=postgresql+psycopg://fastnexa:change-me-to-a-long-random-password@db:5432/fastnexa_outreach

# --- Secrets
# 32 random bytes, base64: python -m app.cli generate-key. Keep a copy somewhere safe:
# without it, saved mailbox passwords can't be decrypted, even from a backup.
ENCRYPTION_KEY=
SESSION_SECRET=

# --- Error tracking (Sentry, or GlitchTip). Leave empty to turn off.
SENTRY_DSN=

# --- Backups (restic). Example for Cloudflare R2; Backblaze B2 works the same way via its S3 API.
RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/nexareach-backups
RESTIC_PASSWORD=another-long-random-password-keep-a-copy-offline
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Hour of the day (UTC) to back up, and how many daily backups to keep.
BACKUP_HOUR=21
BACKUP_KEEP_DAILY=30
PGUSER=fastnexa
PGPASSWORD=change-me-to-a-long-random-password
PGDATABASE=fastnexa_outreach
