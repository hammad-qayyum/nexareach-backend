# Staging on this laptop: the newest code, its own database, REAL email allowed.
# Copy to .env.staging (never commit it) and fill in ENCRYPTION_KEY. Run it with scripts/staging.sh.
#
# It is not the development copy: mailboxes and helpers here are real accounts and every email really goes out.
# It is not production either: its own database (fastnexa_staging), only on this computer.
APP_ENV=staging
DATABASE_URL=postgresql+psycopg://fastnexa:fastnexa@localhost:5433/fastnexa_staging
# A NEW key, not the development or production one: .venv/bin/python -m app.cli generate-key
ENCRYPTION_KEY=
# 127.0.0.1 (not localhost) so its sign-in cookie doesn't mix with the development copy's.
APP_BASE_URL=http://127.0.0.1:3001
COOKIE_SECURE=false
API_DOCS=true
SMTP_ALLOW_PLAIN=false
SENTRY_DSN=
